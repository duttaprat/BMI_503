    "---\n",
    "## 2. Part 1: Biopython - Sequence Manipulation <a name=\"biopython\"></a>\n",
    "\n",
    "Biopython is the most widely used Python library for bioinformatics. Let's explore its capabilities!\n",
    "\n",
    "### 2.1 Creating and Manipulating Sequences"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a DNA sequence\n",
    "dna_seq = Seq(\"ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG\")\n",
    "\n",
    "print(\"Original DNA sequence:\")\n",
    "print(dna_seq)\n",
    "print(f\"Length: {len(dna_seq)} bp\\n\")\n",
    "\n",
    "# Basic operations\n",
    "print(\"Complement:\")\n",
    "print(dna_seq.complement())\n",
    "print()\n",
    "\n",
    "print(\"Reverse Complement:\")\n",
    "print(dna_seq.reverse_complement())\n",
    "print()\n",
    "\n",
    "# Transcription (DNA to RNA)\n",
    "rna_seq = dna_seq.transcribe()\n",
    "print(\"RNA sequence (transcription):\")\n",
    "print(rna_seq)\n",
    "print()\n",
    "\n",
    "# Translation (RNA to Protein)\n",
    "protein_seq = rna_seq.translate()\n",
    "print(\"Protein sequence (translation):\")\n",
    "print(protein_seq)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.2 Calculating Sequence Properties"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# GC content\n",
    "gc_content = SeqUtils.gc_fraction(dna_seq) * 100\n",
    "print(f\"GC Content: {gc_content:.2f}%\")\n",
    "\n",
    "# Count nucleotides\n",
    "print(\"\\nNucleotide counts:\")\n",
    "for nucleotide in ['A', 'T', 'G', 'C']:\n",
    "    count = dna_seq.count(nucleotide)\n",
    "    percentage = (count / len(dna_seq)) * 100\n",
    "    print(f\"{nucleotide}: {count} ({percentage:.1f}%)\")\n",
    "\n",
    "# Molecular weight\n",
    "mw = SeqUtils.molecular_weight(dna_seq)\n",
    "print(f\"\\nMolecular Weight: {mw:.2f} g/mol\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.3 Downloading Sequences from NCBI\n",
    "\n",
    "Let's download a real gene sequence from NCBI GenBank."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set your email (required by NCBI)\n",
    "Entrez.email = \"your.email@example.com\"  # Replace with your email\n",
    "\n",
    "# Download human TP53 gene (tumor suppressor gene)\n",
    "gene_id = \"NM_000546\"  # TP53 mRNA accession number\n",
    "\n",
    "print(f\"Downloading {gene_id} from NCBI...\")\n",
    "handle = Entrez.efetch(db=\"nucleotide\", id=gene_id, rettype=\"fasta\", retmode=\"text\")\n",
    "record = SeqIO.read(handle, \"fasta\")\n",
    "handle.close()\n",
    "\n",
    "print(f\"\\n✅ Downloaded: {record.description}\")\n",
    "print(f\"Sequence length: {len(record.seq)} bp\")\n",
    "print(f\"\\nFirst 100 nucleotides:\")\n",
    "print(record.seq[:100])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.4 Working with FASTA Files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a sample FASTA file\n",
    "sequences = [\n",
    "    SeqRecord(Seq(\"ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG\"), \n",
    "              id=\"gene1\", description=\"Sample gene 1\"),\n",
    "    SeqRecord(Seq(\"GTGAAAAAGATGCAATCTATCGTACTCGCACTTTCCCTG\"), \n",
    "              id=\"gene2\", description=\"Sample gene 2\"),\n",
    "    SeqRecord(Seq(\"CGACTGCGTACTTCGCGTTACGCTTAAGGAGCCTACGCG\"), \n",
    "              id=\"gene3\", description=\"Sample gene 3\")\n",
    "]\n",
    "\n",
    "# Write to FASTA file\n",
    "with open(\"sample_sequences.fasta\", \"w\") as output_handle:\n",
    "    SeqIO.write(sequences, output_handle, \"fasta\")\n",
    "\n",
    "print(\"✅ Created sample_sequences.fasta\")\n",
    "\n",
    "# Read FASTA file\n",
    "print(\"\\nReading FASTA file:\")\n",
    "for record in SeqIO.parse(\"sample_sequences.fasta\", \"fasta\"):\n",
    "    print(f\"ID: {record.id}\")\n",
    "    print(f\"Description: {record.description}\")\n",
    "    print(f\"Sequence: {record.seq}\")\n",
    "    print(f\"Length: {len(record.seq)} bp\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.5 Finding Motifs in Sequences"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Search for TATA box (common promoter element)\n",
    "sequence = Seq(\"GCGCAATAAAAGCGCGCTTATATAGCGCGCAATAAATGCGC\")\n",
    "motif = \"TATA\"\n",
    "\n",
    "print(f\"Searching for '{motif}' motif in sequence:\")\n",
    "print(sequence)\n",
    "print()\n",
    "\n",
    "# Find all occurrences\n",
    "start_positions = []\n",
    "for i in range(len(sequence) - len(motif) + 1):\n",
    "    if sequence[i:i+len(motif)] == motif:\n",
    "        start_positions.append(i)\n",
    "\n",
    "if start_positions:\n",
    "    print(f\"Found {len(start_positions)} occurrence(s) at position(s): {start_positions}\")\n",
    "else:\n",
    "    print(\"Motif not found\")\n",
    "\n",
    "# Search for restriction enzyme sites (EcoRI: GAATTC)\n",
    "test_seq = Seq(\"ATGGAATTCGCGAATTCGCGATCG\")\n",
    "restriction_site = \"GAATTC\"\n",
    "print(f\"\\nSearching for EcoRI site ({restriction_site}):\")\n",
    "print(test_seq)\n",
    "print(f\"Found at positions: {[i for i in range(len(test_seq)) if test_seq[i:i+6] == restriction_site]}\")"
   ]
  },
  {
   "cell_type": "markdown",
